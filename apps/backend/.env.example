NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

DATABASE_URL="mysql://root:password@127.0.0.1:3306/rag_kb?connection_limit=10"

JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

UPLOAD_DIR=uploads

EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=256
EMBEDDING_BATCH_SIZE=20

LLM_PROVIDER=mock
LLM_MODEL=mock-rag

CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.15

# Reserved for extension (v2):
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_PREFIX=rag-backend
