NODE_ENV=development
PORT=3001
APP_NAME=nexairon-rag-backend
APP_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

JWT_SECRET=replace_me
JWT_EXPIRES_IN=7d

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=838571025
MYSQL_DATABASE=rag_kb

USE_VECTOR_DB=false
VECTOR_DB_HOST=127.0.0.1
VECTOR_DB_PORT=5432
VECTOR_DB_USERNAME=postgres
VECTOR_DB_PASSWORD=123456
VECTOR_DB_DATABASE=rag_vector
VECTOR_EMBEDDING_DIM=1536

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.2

ENABLE_QUEUE=false
ENABLE_SWAGGER=true
LOG_LEVEL=debug
