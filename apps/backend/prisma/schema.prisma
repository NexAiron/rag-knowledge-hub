generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  uploaded
  processing
  completed
  failed
}

enum MessageRole {
  user
  assistant
  system
}

model User {
  id             String          @id @default(cuid()) @db.VarChar(191)
  email          String          @unique @db.VarChar(191)
  passwordHash   String          @map("password_hash") @db.VarChar(255)
  name           String?         @db.VarChar(100)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  knowledgeBases KnowledgeBase[]
  conversations  Conversation[]

  @@index([createdAt], map: "idx_users_created_at")
  @@map("users")
}

model KnowledgeBase {
  id            String         @id @default(cuid()) @db.VarChar(191)
  userId        String         @map("user_id") @db.VarChar(191)
  name          String         @db.VarChar(150)
  description   String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     Document[]
  chunks        Chunk[]
  conversations Conversation[]

  @@index([userId, createdAt], map: "idx_knowledge_bases_user_id_created_at")
  @@map("knowledge_bases")
}

model Document {
  id              String         @id @default(cuid()) @db.VarChar(191)
  knowledgeBaseId String         @map("knowledge_base_id") @db.VarChar(191)
  title           String         @db.VarChar(255)
  fileName        String         @map("file_name") @db.VarChar(255)
  filePath        String         @map("file_path") @db.VarChar(500)
  mimeType        String         @map("mime_type") @db.VarChar(100)
  size            Int            @map("size_bytes")
  status          DocumentStatus @default(uploaded)
  errorMessage    String?        @map("error_message") @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  knowledgeBase   KnowledgeBase  @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks          Chunk[]

  @@index([knowledgeBaseId, status], map: "idx_documents_kb_id_status")
  @@index([knowledgeBaseId, createdAt], map: "idx_documents_kb_id_created_at")
  @@index([createdAt], map: "idx_documents_created_at")
  @@map("documents")
}

model Chunk {
  id              String        @id @default(cuid()) @db.VarChar(191)
  knowledgeBaseId String        @map("knowledge_base_id") @db.VarChar(191)
  documentId      String        @map("document_id") @db.VarChar(191)
  content         String        @db.LongText
  page            Int?          @map("page_number")
  chunkIndex      Int           @map("chunk_index")
  tokenCount      Int?          @map("token_count")
  metadata        Json?
  embedding       Json?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex], map: "uk_chunks_document_id_chunk_index")
  @@index([knowledgeBaseId, createdAt], map: "idx_chunks_kb_id_created_at")
  @@index([documentId], map: "idx_chunks_document_id")
  @@index([knowledgeBaseId, documentId], map: "idx_chunks_kb_id_document_id")
  @@map("chunks")
}

model Conversation {
  id              String        @id @default(cuid()) @db.VarChar(191)
  userId          String        @map("user_id") @db.VarChar(191)
  knowledgeBaseId String        @map("knowledge_base_id") @db.VarChar(191)
  title           String?       @db.VarChar(255)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@index([userId, knowledgeBaseId, updatedAt], map: "idx_conversations_user_id_kb_id_updated_at")
  @@index([knowledgeBaseId, updatedAt], map: "idx_conversations_kb_id_updated_at")
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid()) @db.VarChar(191)
  conversationId String       @map("conversation_id") @db.VarChar(191)
  role           MessageRole
  content        String       @db.LongText
  sources        Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], map: "idx_messages_conversation_id_created_at")
  @@index([role, createdAt], map: "idx_messages_role_created_at")
  @@map("messages")
}
